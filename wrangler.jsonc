{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rhanthai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:8787"
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "env": {
    "production": {
      "vars": {
        "PUBLIC_ORIGIN": "https://rhanthai.supakorn.me"
      },
      "routes": [
        {
          "pattern": "rhanthai.supakorn.me",
          "custom_domain": true
        }
      ]
    }
  }
}
