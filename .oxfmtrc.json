{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "docs/**",
    "tasks/**",
    "SPEC.md",
    "README.md",
    "bun.lock",
    "tests/fixtures/public/**"
  ]
}
