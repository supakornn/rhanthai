{
  "name": "rhanthai",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.6"
  },
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "wrangler dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "validate:data": "bun scripts/validate-data.ts",
    "validate:api": "bun scripts/validate-api.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "bun run build && vitest run --config vitest.config.ts",
    "build": "wrangler deploy --env= --dry-run --outdir dist",
    "smoke": "bun scripts/smoke.ts",
    "deploy": "wrangler deploy --env production --message $GITHUB_SHA"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "elysia": "1.4.30"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@biomejs/biome": "2.6.3",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "26.6.5",
    "image-size": "2.0.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.152.0",
    "yaml": "2.9.1"
  }
}
