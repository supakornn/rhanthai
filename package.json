{
  "name": "rhanthai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "lint": "oxlint . && bun run format:check",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "validate:data": "bun scripts/validate-data.ts",
    "validate:api": "bun scripts/validate-api.ts",
    "generate:api": "bun scripts/validate-api.ts --export",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "bun run build && vitest run --config vitest.config.ts",
    "build": "wrangler deploy --env= --dry-run --outdir dist",
    "build:production": "wrangler deploy --env production --dry-run --outdir dist-production",
    "smoke": "bun scripts/smoke.ts",
    "deploy": "wrangler deploy --env production --var \"APP_REVISION:${WORKERS_CI_COMMIT_SHA:-local}\" && bun run smoke https://rhanthai.supakorn.me \"${WORKERS_CI_COMMIT_SHA:-local}\""
  },
  "dependencies": {
    "@elysia/openapi": "1.4.16",
    "@sinclair/typebox": "0.34.52",
    "elysia": "1.4.30"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "image-size": "2.0.4",
    "openapi-types": "12.1.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.154.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.6"
  },
  "packageManager": "bun@1.4.3"
}
